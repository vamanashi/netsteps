              "インタフェース",
              "用途"
            ],
            "rows": [
              [
                "65000:1",
                "INT-IF",
                "VPNの外側"
              ],
              [
                "65000:2",
                "LAN-IFとトンネルIF",
                "業務パケット"
              ]
            ],
            "caption": "説明用の図表"
