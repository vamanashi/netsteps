    {
      "id": "redundancy",
      "title": "故障しても足りる台数を選ぶ",
      "targets": [
        "s3-1"
      ],
      "steps": [
        {
          "type": "info",
          "title": "通常時の合計だけを見ない",
          "body": "Active-Standbyは稼働系と待機系、Active-Activeは複数台が同時処理する構成です。2台で通常時に足りても、1台故障後の残り1台では性能不足になり得ます。原問の必要能力1.4倍と3台構成の理由を、残る能力から判断します。",
          "id": "redundancy-1",
          "format": "読む",
          "theme": "故障しても足りる台数を選ぶ",
          "stage": "concept",
          "scaffold": 5
        },
        {
          "type": "quiz",
          "title": "練習用：1台の能力を1、必要量1.4。2台稼働から1台故障すると？",
          "choices": [
            {
              "text": "通常時の合計2が残る",
              "explain": "故障機の処理能力は利用できません。"
            },
            {
              "text": "残り能力1で不足する",
              "ok": true,
              "explain": "必要量1.4より小さいので処理を継続しきれません。"
            }
          ],
          "id": "redundancy-2",
          "format": "選択",
          "theme": "故障しても足りる台数を選ぶ",
          "stage": "check",
          "scaffold": 4
        },
        {
          "type": "quiz",
          "title": "同能力のFWを3台にする主目的は？",
          "choices": [
            {
              "text": "1台故障後も2台分で必要量を満たす",
              "ok": true,
              "explain": "正常時だけでなく障害時の余力を確保します。"
            },
            {
              "text": "3台ならどんな負荷でも耐える",
              "explain": "必要量が残存能力を超えれば不足します。"
            }
          ],
          "id": "redundancy-3",
          "format": "選択",
          "theme": "故障しても足りる台数を選ぶ",
          "stage": "reason",
          "scaffold": 3
        },
        {
          "type": "blank",
          "title": "原問の目的を短くする",
          "template": "FWを3台にするのは、{a}の性能を{b}ためである。",
          "blanks": [
            {
              "key": "a",
              "label": "空欄1",
              "choices": [
                {
                  "text": "故障発生時",
                  "ok": true,
                  "explain": "1台喪失した条件で評価します。"
                },
                {
                  "text": "ログ取得停止時",
                  "explain": "原問の追加台数の理由ではありません。"
                }
              ],
              "why": "1台喪失した条件で評価します。"
            },
            {
              "key": "b",
              "label": "空欄2",
              "choices": [
                {
                  "text": "不足させない",
                  "ok": true,
                  "explain": "必要量を残る装置で処理します。"
                },
                {
                  "text": "全く見積もらなくてよくする",
                  "explain": "台数を増やしても能力の比較は必要です。"
                }
              ],
              "why": "必要量を残る装置で処理します。"
            }
          ],
          "id": "redundancy-4",
          "format": "穴埋め",
          "theme": "故障しても足りる台数を選ぶ",
          "stage": "assemble",
          "scaffold": 2
        },
        {
          "type": "parsons",
          "title": "必要台数を決める",
          "lead": "同じ能力のFWを想定します。",
          "lines": [
            {
              "code": "必要な処理能力を見積もる"
            },
            {
              "code": "故障後に残る台数の合計能力を求める"
