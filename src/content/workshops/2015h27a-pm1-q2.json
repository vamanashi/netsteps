            "kind": "encap",
            "layers": [
              {
                "label": "小さいパケットの例",
                "parts": [
                  {
                    "t": "ヘッダ",
                    "w": 1,
                    "role": "header"
                  },
                  {
                    "t": "データ",
                    "w": 1,
                    "role": "data"
                  }
                ]
              },
              {
                "label": "大きいパケットの例",
                "parts": [
                  {
                    "t": "ヘッダ",
                    "w": 1,
                    "role": "header"
                  },
                  {
                    "t": "データ",
                    "w": 4,
                    "role": "data"
                  }
                ]
              }
            ],
            "caption": "説明用の比率：どちらもパケット処理は1回"
          },
