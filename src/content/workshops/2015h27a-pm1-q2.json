          "template": "透過型LBは宛先{a}を振り分け先FWへ変更し、宛先{b}は機器bのままにする。",
          "blanks": [
            {
              "key": "a",
              "label": "空欄1",
              "choices": [
                {
                  "text": "MACアドレス",
                  "ok": true,
                  "explain": "LAN内の次の受渡し先を選びます。"
                },
                {
                  "text": "IPアドレス",
                  "explain": "最終相手を変えてしまいます。"
                }
              ],
              "why": "LAN内の次の受渡し先を選びます。"
            },
            {
              "key": "b",
              "label": "空欄2",
              "choices": [
                {
                  "text": "IPアドレス",
                  "ok": true,
                  "explain": "中継後も通信終端はbです。"
                },
                {
                  "text": "MACアドレス",
                  "explain": "FW選択に応じて変更します。"
                }
              ],
              "why": "中継後も通信終端はbです。"
            }
          ],
          "id": "ip-mac-4",
          "format": "穴埋め",
          "theme": "最終宛先と次の受渡し先",
          "stage": "assemble",
          "scaffold": 2
        },
        {
          "type": "parsons",
          "title": "透過型の制約を説明する",
