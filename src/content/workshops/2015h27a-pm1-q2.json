    {
      "id": "ip-mac",
      "title": "最終宛先と次の受渡し先",
      "targets": [
        "s2-1",
        "s2-2"
      ],
      "steps": [
        {
          "type": "info",
          "title": "二つの宛先を見る",
          "body": "IP（Internet Protocol）の宛先は通信の最終相手を表し、MAC（Media Access Control）の宛先はLAN内の受渡し先を表します。FW（Firewall、ファイアウォール）が中継するだけなら、最終相手のIPをFWのIPへ置き換えることはできません。原問の透過型LBはMACの宛先を変えてFWを選びます。",
          "fig": {
            "kind": "topo",
            "height": 170,
            "nodes": [
              {
                "id": "node0",
                "label": "機器a",
                "icon": "pc",
                "x": 60,
                "y": 85
              },
              {
                "id": "node1",
                "label": "中継するFW",
                "icon": "fw",
                "x": 165,
                "y": 85
              },
              {
                "id": "node2",
                "label": "機器b",
                "icon": "server",
                "x": 270,
                "y": 85
              }
            ],
            "links": [
              {
                "from": "node0",
                "to": "node1"
              },
              {
                "from": "node1",
                "to": "node2"
              }
            ],
            "caption": "説明用：終端a・bと途中のFW"
          },
          "id": "ip-mac-1",
          "format": "読む",
          "theme": "最終宛先と次の受渡し先",
          "stage": "concept",
          "scaffold": 5
        },
        {
          "type": "quiz",
          "title": "機器aが別ネットワークの機器bへ送る。宛先IPは？",
          "choices": [
            {
              "text": "途中のFWのIP",
              "explain": "FW自体への要求ではありません。"
            },
            {
              "text": "機器bのIP",
              "ok": true,
              "explain": "最終的に通信を受け取る相手です。"
            }
          ],
          "id": "ip-mac-2",
          "format": "選択",
          "theme": "最終宛先と次の受渡し先",
          "stage": "check",
          "scaffold": 4
        },
        {
          "type": "quiz",
          "title": "この透過型LBがFWを選ぶときに宛先IPを変えられない理由は？",
          "choices": [
            {
              "text": "FWはセッションの終端ではないから",
              "ok": true,
              "explain": "相手bへの通信として通過させる必要があります。"
            },
            {
              "text": "MACもIPも絶対に変えられないから",
              "explain": "本文のLBは宛先MACを変えて振り分けます。"
            }
          ],
          "id": "ip-mac-3",
          "format": "選択",
          "theme": "最終宛先と次の受渡し先",
          "stage": "reason",
          "scaffold": 3
