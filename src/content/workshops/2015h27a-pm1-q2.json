      ],
      "steps": [
        {
          "type": "info",
          "title": "返事にも通信の履歴が必要",
          "body": "動的フィルタリングは、開始した通信の状態を記録して応答を許可します。原問の両側LBが同じセッションを別々のFWへ送ると、復路のFWに往路の記録がありません。障害時のセッション維持と、通常時の往復一致は分けて考えます。",
          "id": "symmetry-1",
          "format": "読む",
          "theme": "往路と復路で同じ検査記録を使う",
          "stage": "concept",
          "scaffold": 5
        },
        {
          "type": "quiz",
          "title": "往路はFW1、復路は記録を共有しないFW2。何が問題？",
          "choices": [
            {
              "text": "IPの宛先が自動的に消える",
              "explain": "原因は状態記録の不一致で、IPヘッダの消失ではありません。"
            },
            {
              "text": "FW2が正しい応答だと確認できない",
              "ok": true,
              "explain": "FW1に作られた状態がFW2にはありません。"
            }
          ],
          "id": "symmetry-2",
          "format": "選択",
