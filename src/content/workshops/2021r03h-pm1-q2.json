          "template": "Type1は{b}LSAで、評価値は{c}という。最短経路は{d}アルゴリズムで求める。",
          "blanks": [
            {
              "key": "b",
              "label": "b",
              "choices": [
                {
                  "text": "ルータ",
                  "ok": true,
