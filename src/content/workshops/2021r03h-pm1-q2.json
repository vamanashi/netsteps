            },
            {
              "key": "c",
              "label": "c",
              "choices": [
                {
                  "text": "コスト",
                  "ok": true,
                  "explain": "OSPFが経路の評価に使う値です。"
                },
                {
                  "text": "TTL",
                  "ok": false,
                  "explain": "パケットの生存期間を制限する値です。"
                },
                {
                  "text": "MAC",
                  "ok": false,
                  "explain": "レイヤ2の機器識別に用います。"
                }
              ],
              "why": "OSPFが経路の評価に使う値です。"
            },
            {
              "key": "d",
              "label": "d",
              "choices": [
                {
                  "text": "ダイクストラ",
                  "ok": true,
                  "explain": "リンク状態から最短経路を計算します。"
                },
                {
                  "text": "ラウンドロビン",
                  "ok": false,
                  "explain": "順番に資源を割り当てる方式です。"
                },
                {
                  "text": "NAT",
                  "ok": false,
                  "explain": "IPアドレスを変換する機能です。"
                }
              ],
              "why": "リンク状態から最短経路を計算します。"
            }
          ],
          "originalExcerpt": {
            "page": 10,
            "top": 0.365,
            "bottom": 0.67,
            "label": "OSPFのLSAと最短経路計算（IPA原典）"
          }
        },
        {
          "id": "spf-5",
          "format": "並べ替え",
          "theme": "リンク情報から経路を計算する",
          "scaffold": 1,
          "stage": "assemble",
          "type": "parsons",
          "title": "経路表ができる順に並べよ。",
