          "choices": [
            {
              "text": "区間数が同じでないので比較不能",
              "ok": false,
              "explain": "合計コストで比較できます。"
            },
            {
              "text": "直行を選ぶ",
              "ok": true,
              "explain": "迂回は10＋25＝35なので直行30が小さくなります。"
            },
            {
              "text": "以前の迂回を永久に使う",
              "ok": false,
              "explain": "リンク情報が更新されれば経路を再計算します。"
            }
          ]
