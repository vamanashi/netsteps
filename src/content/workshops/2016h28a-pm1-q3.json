    {
      "id": "rr",
      "title": "分散が偏る条件を考える",
      "targets": [
        "s1-4"
      ],
      "steps": [
        {
          "id": "rr-1",
          "format": "読む",
          "theme": "分散が偏る条件を考える",
          "scaffold": 5,
          "type": "info",
          "title": "DNSはメールごとには引かない",
          "body": "DNSラウンドロビンは複数の宛先を順序を変えて返す方式です。一度得た宛先をキャッシュしている間は、送信元が同じ宛先を使い続けます。送信元が少数だと選択回数が少なく、偏った選択が長時間続きます。設問1(4)では『偏る条件』と『偏りが続く理由』を分けて答えます。",
          "stage": "concept",
          "fig": {
            "kind": "console",
            "lines": [
              "送信元X: DNS応答 -> MSV1を選択",
              "キャッシュ有効中: 100通ともMSV1へ",
              "送信元Y: MSV1を選ぶと更に偏る"
            ],
            "caption": "説明用：練習用：宛先選択の回数とメール通数は別"
          }
        },
        {
          "id": "rr-2",
          "format": "選択",
          "theme": "分散が偏る条件を考える",
          "scaffold": 3,
          "type": "quiz",
          "title": "少数の送信元が大量に送る場合、分散が偏ることはある？",
          "choices": [
            {
              "text": "ない。必ず1通ごとに別サーバを選ぶ",
              "explain": "DNSのキャッシュ利用を無視しています。",
              "ok": false
            },
            {
              "text": "ある。宛先を選ぶ主体が少ない",
              "explain": "メール数が多くてもDNS選択がメールごととは限りません。",
              "ok": true
            }
          ],
          "stage": "check"
        },
        {
          "id": "rr-3",
          "format": "選択",
          "theme": "分散が偏る条件を考える",
          "scaffold": 3,
          "type": "quiz",
          "title": "一度生じた偏りが長く続く理由は？",
          "choices": [
            {
              "text": "SMTPが宛先名を暗号化するから",
              "explain": "暗号化の有無ではなく宛先情報の再利用が原因です。",
              "ok": false
            },
            {
              "text": "DNSキャッシュが生存する間は宛先を変えないから",
              "explain": "この条件で同じサーバへの転送が継続します。",
              "ok": true
            }
          ],
          "stage": "reason"
        },
        {
          "id": "rr-4",
          "format": "穴埋め",
          "theme": "分散が偏る条件を考える",
          "scaffold": 3,
          "type": "blank",
          "title": "条件と理由を別々に",
          "template": "偏りやすいのは送信元が{a}の場合。{b}の間、宛先を変えないので偏りが続く。",
          "stage": "apply",
          "blanks": [
            {
              "key": "a",
              "label": "条件",
              "why": "宛先を選ぶ主体の数を考えます。",
              "choices": [
                {
                  "text": "十分多数で各々独立に選択",
                  "explain": "少数の場合より選択は均されやすく、原問の条件ではありません。",
                  "ok": false
                },
                {
                  "text": "少数",
                  "explain": "選択結果が均されにくくなります。",
                  "ok": true
                }
              ]
            },
            {
              "key": "b",
              "label": "理由",
              "why": "名前解決結果の再利用です。",
              "choices": [
                {
                  "text": "メールボックスが空",
                  "explain": "メールボックスの空き具合をDNSが見て選ぶ方式ではありません。",
                  "ok": false
                },
                {
                  "text": "DNSキャッシュが生存している",
                  "explain": "以前選んだ宛先を使います。",
                  "ok": true
                }
              ]
            }
          ]
        },
        {
          "id": "rr-5",
          "format": "並べ替え",
          "theme": "分散が偏る条件を考える",
          "scaffold": 1,
          "type": "parsons",
          "title": "偏りを因果で説明する",
          "lead": "条件→動作→継続の順。",
          "stage": "assemble",
          "lines": [
            {
              "code": "送信元が少数で宛先選択が偏る"
            },
            {
              "code": "各送信元がDNSキャッシュの宛先を再利用する"
            },
            {
              "code": "キャッシュが生存する間、同じ宛先への偏りが続く"
            }
          ],
          "shuffled": [
            0,
            2,
            1
          ],
          "okOrders": [
            [
              0,
              1,
              2
            ]
          ],
          "okExplain": "発生条件と継続理由の両要素が必要です。",
          "ngExplain": "『キャッシュがある』だけでは、どの条件で偏りやすいかを説明できません。"
        },
        {
          "id": "rr-6",
          "format": "選択",
          "theme": "分散が偏る条件を考える",
          "scaffold": 0,
          "type": "quiz",
          "title": "練習用変更：独立した送信元が数千へ増えた。少数の場合に比べて？",
          "choices": [
            {
              "text": "必ず各サーバが同じ通数になる",
              "explain": "DNSはメール通数や負荷を厳密に配分する装置ではありません。",
              "ok": false
            },
            {
              "text": "宛先選択が分散しやすいが、厳密な均等は保証しない",
              "explain": "送信量やキャッシュ利用もあり完全均等とは言えません。",
              "ok": true
            }
          ],
          "stage": "transfer"
        }
      ]
    },
