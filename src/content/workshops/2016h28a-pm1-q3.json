          "fig": {
            "kind": "topo",
            "height": 210,
            "nodes": [
              {
                "id": "primary",
                "label": "DNS1 原本",
                "icon": "server",
                "x": 60,
                "y": 100
              },
              {
                "id": "internal",
                "label": "DNS2 社内用",
                "icon": "server",
                "x": 250,
                "y": 45
              },
              {
                "id": "external",
                "label": "DNS3 公開用",
                "icon": "server",
                "x": 250,
                "y": 155
              }
