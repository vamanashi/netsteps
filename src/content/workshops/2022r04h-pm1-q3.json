      "steps": [
        {
          "type": "info",
          "title": "直接通信に必要なPC設定を選ぶ",
          "body": "PC（Personal Computer）は社内サーバへ直接接続し、外部Webにはプロキシ（通信の中継役）を使います。FQDN（Fully Qualified Domain Name）はドメインまで含めた完全なホスト名、DNS（Domain Name System）はその名前をIP（Internet Protocol）アドレスへ解決する仕組みです。プロキシ例外には直接つなぐ業務・営業支援サーバの名前を登録します。",
          "fig": {
            "kind": "table",
            "head": [
              "用途",
              "設定"
            ],
            "rows": [
              [
                "社内サーバをプロキシから除外",
                "業務・営業支援サーバのFQDN"
              ],
              [
                "名前解決",
                "社内DNSサーバのIP"
              ],
              [
                "他ネットワークへの転送",
                "デフォルトゲートウェイのIP"
              ]
            ],
            "caption": "説明用の図表"
          },
          "id": "local-1",
          "format": "読む",
          "theme": "直接通信に必要なPC設定を選ぶ",
          "scaffold": 5,
          "stage": "concept"
        },
        {
          "type": "quiz",
          "title": "社内サーバを直接利用するため、プロキシ例外に入れるものはどれか。",
          "choices": [
            {
              "text": "社内DNSの全キャッシュ",
              "ok": false,
              "explain": "プロキシ例外の指定対象ではありません。"
            },
            {
              "text": "PCのMACアドレス",
              "ok": false,
              "explain": "アクセス先を識別できません。"
            },
            {
              "text": "業務サーバと営業支援サーバのFQDN",
              "ok": true,
              "explain": "名前でアクセスする対象を例外にします。"
            }
          ],
          "id": "local-2",
          "format": "選択",
          "theme": "直接通信に必要なPC設定を選ぶ",
          "scaffold": 5,
          "stage": "check"
        },
        {
          "type": "quiz",
          "title": "PCが外部DNSへの転送を社内DNSに依頼するため必要なのはどれか。",
          "choices": [
            {
              "text": "Webサーバの秘密鍵",
              "ok": false,
              "explain": "名前解決先の設定ではありません。"
            },
            {
              "text": "社内DNSサーバのIPアドレス",
              "ok": true,
              "explain": "スタブリゾルバの問合せ先です。"
            },
            {
              "text": "外部DNSのMACアドレス",
              "ok": false,
              "explain": "PCは社内DNSへ問い合わせる条件です。"
            }
          ],
          "id": "local-3",
          "format": "選択",
          "theme": "直接通信に必要なPC設定を選ぶ",
          "scaffold": 4,
          "stage": "reason"
        },
        {
          "id": "local-7",
          "type": "info",
          "title": "名前解決と経路設定は別の仕事",
          "body": "DHCP（Dynamic Host Configuration Protocol）は端末へネットワーク設定を配布します。DNSサーバのIPは名前の問合せ先、デフォルトゲートウェイのIPは別サブネットへ送る次ホップです。原問ではPCのIP・サブネットマスクに加え、この二つのIPが必要です。",
          "format": "読む",
          "theme": "名前解決と経路設定は別の仕事",
          "scaffold": 5,
          "stage": "concept"
        },
        {
          "type": "blank",
          "title": "DHCPで渡す二つの情報を埋める",
          "template": "名前解決には{a}、別サブネットへの送信には{b}を使う。",
          "blanks": [
