    {
      "id": "tickets",
      "title": "TGTとSTの役割を区別する",
      "targets": [
        "s2-1",
        "s2-2"
      ],
      "steps": [
        {
          "type": "info",
          "title": "TGTとSTの役割を区別する",
          "body": "SSO（Single Sign-On）は一度の認証で複数サービスを利用する仕組みです。KDC（Key Distribution Center：鍵配布センタ）はTGT（Ticket Granting Ticket：サービス用チケットを求めるためのチケット）を発行します。PCはTGTで対象サーバ用のST（Service Ticket）を取得し、そのサーバへ提示します。次の暗号の説明は原問の簡略化されたモデルに従います。",
          "fig": {
            "kind": "flow",
            "steps": [
              {
                "t": "①",
                "d": "PC→KDC 認証要求"
              },
              {
                "t": "②",
                "d": "KDC→PC TGT"
              },
              {
                "t": "⑤",
                "d": "PC→KDC ST要求"
              },
              {
                "t": "⑥",
                "d": "KDC→PC ST"
              },
              {
                "t": "⑦",
                "d": "PC→サーバ ST提示"
              }
            ],
            "caption": "説明用の流れ"
          },
          "id": "tickets-1",
          "format": "読む",
          "theme": "TGTとSTの役割を区別する",
          "scaffold": 5,
          "stage": "concept"
        },
