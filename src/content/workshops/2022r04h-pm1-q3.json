    {
      "id": "fw",
      "title": "通信の役割からFW表を埋める",
      "targets": [
        "s1-3",
        "s1-4"
      ],
      "steps": [
        {
          "type": "info",
          "title": "通信の役割からFW表を埋める",
          "body": "FW（Firewall：ファイアウォール）は通信を許可・拒否します。DMZ（Demilitarized Zone）は外部向けサーバ用の分離領域です。原問の外部DNSは公開する名前を管理し、社内DNSからの再帰問合せも受けます。公開Webは外部からHTTPS（HTTP over TLS）を受け、プロキシは内部からのWeb要求を外へ中継します。",
          "fig": {
            "kind": "table",
            "head": [
              "通信",
              "送信元→宛先"
            ],
            "rows": [
              [
                "外部から名前解決",
                "インターネット→外部DNS"
              ],
              [
                "外部からHTTPS",
                "インターネット→公開Web"
              ],
              [
                "プロキシの外向きWeb",
                "プロキシ→インターネット"
              ],
              [
                "社内DNSの再帰問合せ",
                "社内DNS→外部DNS"
              ]
            ],
            "caption": "説明用の図表"
          },
          "id": "fw-1",
          "format": "読む",
          "theme": "通信の役割からFW表を埋める",
          "scaffold": 5,
          "stage": "concept"
        },
        {
          "id": "fw-7",
          "type": "info",
          "title": "FWの行は方向・相手・サービスを読む",
          "body": "TCP（Transmission Control Protocol）やUDP（User Datagram Protocol）の宛先ポートでサービスを指定します。DNSは53番、原問のHTTPSはTCP 443番、HTTP（Hypertext Transfer Protocol）は80番です。TLS（Transport Layer Security）がHTTPSの通信を保護します。表のanyは、その方向の任意のアドレスという指定です。",
          "format": "読む",
          "theme": "FWの行は方向・相手・サービスを読む",
          "scaffold": 5,
          "stage": "concept"
        },
        {
          "type": "quiz",
          "title": "DNSの通常問合せで表のTCP/53と組にするものはどれか。",
          "choices": [
            {
              "text": "UDP/443",
              "ok": false,
              "explain": "DNSの通常ポートは53です。HTTPSでUDPを用いる場合とは区別します。"
            },
            {
              "text": "TCP/88",
              "ok": false,
              "explain": "Kerberosのサービスポートです。"
            },
            {
              "text": "UDP/53",
              "ok": true,
              "explain": "通常のDNS問合せで使います。大きな応答などではTCPも使います。"
            }
          ],
          "id": "fw-2",
          "format": "選択",
          "theme": "通信の役割からFW表を埋める",
          "scaffold": 5,
          "stage": "check"
        },
        {
          "type": "quiz",
          "title": "PCセグメントから外部へ直接Web通信を許可するべきか。",
          "choices": [
            {
              "text": "DNS通信も全てプロキシへ送る",
              "ok": false,
              "explain": "DNSの問合せ先は社内DNSです。"
            },
            {
              "text": "許可せずプロキシを経由させる",
              "ok": true,
              "explain": "原問ではプロキシがWeb通信を中継します。"
            },
            {
              "text": "全宛先のTCP/80を直接許可する",
              "ok": false,
              "explain": "プロキシ経由という設計を外れます。"
            }
          ],
          "id": "fw-3",
