        {
          "type": "info",
          "title": "公開サーバからの侵入拡大を抑える",
          "body": "練習用の比較：公開サーバを社内PC（Personal Computer）と同じLAN（Local Area Network）に置く場合を考えます。DMZ（Demilitarized Zone）は外部と通信するサーバ用の分離領域、OA（Office Automation）セグメントは事務用機器の領域です。原問のようにFW（Firewall：ファイアウォール）で両者の通信を制限すると、公開サーバの侵害が社内へ広がるリスクを減らせます。",
          "fig": {
            "kind": "flow",
            "steps": [
              {
                "t": "外部",
                "d": "公開サーバへ接続"
              },
              {
                "t": "DMZ",
                "d": "公開サーバを収容"
              },
              {
                "t": "FW",
                "d": "OAセグメント宛ての通信を制限"
              }
            ],
            "caption": "説明用の流れ"
          },
          "id": "boundary-1",
          "format": "読む",
          "theme": "公開サーバからの侵入拡大を抑える",
          "scaffold": 5,
          "stage": "concept"
        },
        {
          "type": "quiz",
          "title": "公開サーバが侵害された後、守りたい対象はどれか。",
          "choices": [
            {
              "text": "公開サーバの名前だけ",
              "ok": false,
              "explain": "名前の変更では侵入経路はなくなりません。"
            },
            {
              "text": "インターネット全体",
              "ok": false,
              "explain": "社内FWの管理範囲ではありません。"
            },
            {
              "text": "OAセグメントの機器",
              "ok": true,
              "explain": "侵入が社内機器へ広がるリスクを減らします。"
            }
          ],
          "id": "boundary-2",
          "format": "選択",
          "theme": "公開サーバからの侵入拡大を抑える",
          "scaffold": 5,
          "stage": "check"
