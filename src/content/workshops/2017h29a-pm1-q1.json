  "sections": [
    {
      "id": "tls-roles",
      "title": "暗号化だけでは守れない",
      "targets": [
        "s1",
        "s2-1"
      ],
      "steps": [
        {
          "type": "info",
          "title": "秘密・相手・改ざんを分ける",
          "body": "VPN（Virtual Private Network）は離れた機器を論理的に接続します。SSL/TLS（Secure Sockets Layer / Transport Layer Security）を使うVPNでは、秘密を隠す暗号化に加えて、鍵を共有する手段と相手確認、メッセージの改ざん検出が必要です。原問の暗号スイートの用途を、この四つに分けます。",
          "stage": "concept",
          "id": "tls-roles-1",
          "theme": "暗号化だけでは守れない",
          "format": "読む",
          "scaffold": 5
        },
        {
          "type": "quiz",
          "title": "盗聴者に本文を読ませない役割は？",
          "choices": [
            {
              "text": "経路制御",
              "explain": "宛先へ届ける仕組みであり、内容を隠す機能ではありません。",
              "ok": false
            },
            {
              "text": "利用者の認証だけ",
              "explain": "誰が利用するかは確認できても、転送中の本文を隠すこととは別です。",
              "ok": false
            },
            {
              "text": "データの暗号化",
              "explain": "通信内容を読めない形に変える役割です。相手の正しさの保証とは分けます。",
              "ok": true
            }
          ],
          "stage": "check",
          "id": "tls-roles-2",
          "theme": "暗号化だけでは守れない",
          "format": "選択",
          "scaffold": 4
        },
        {
          "type": "quiz",
          "title": "初対面の通信相手と、本文を保護する鍵を安全に用意する用途は？",
          "choices": [
            {
              "text": "鍵交換",
              "explain": "本問でデータ暗号以外に挙げる暗号アルゴリズムの用途の一つです。",
              "ok": true
            },
            {
              "text": "メッセージ認証",
              "explain": "改ざんなどを検証する用途であり、鍵を共有する手順そのものではありません。",
              "ok": false
            }
          ],
          "stage": "check",
          "id": "tls-roles-3",
          "theme": "暗号化だけでは守れない",
          "format": "選択",
          "scaffold": 4
        },
        {
          "type": "quiz",
          "title": "偽のサーバを相手に鍵交換してしまうことを避けたい。追加で必要な用途は？",
          "choices": [
            {
              "text": "圧縮",
              "explain": "データ量を減らしても相手の正当性は確認できません。",
              "ok": false
            },
            {
              "text": "認証",
              "explain": "相手の正当性を確認します。鍵が共有できたことだけでは相手が本物とは限りません。",
              "ok": true
            }
          ],
          "stage": "reason",
          "id": "tls-roles-4",
          "theme": "暗号化だけでは守れない",
          "format": "選択",
          "scaffold": 2
        },
        {
          "type": "blank",
          "title": "三つの用途を対応させる",
          "template": "データ暗号とは別に、鍵を共有する{a}と相手を確認する{b}を使う。本問のハッシュアルゴリズムの用途は{c}である。",
          "blanks": [
            {
              "key": "a",
              "label": "鍵を用意",
              "why": "データを暗号化する前に鍵を共有する用途です。",
              "choices": [
                {
                  "text": "鍵交換",
                  "explain": "暗号化に使う鍵を安全に共有します。",
                  "ok": true
                },
                {
                  "text": "アドレス変換",
                  "explain": "通信先のアドレスを書き換える処理です。",
                  "ok": false
                }
              ]
            },
            {
              "key": "b",
              "label": "相手確認",
              "why": "鍵交換相手を確認する用途です。",
              "choices": [
                {
                  "text": "認証",
                  "explain": "相手が正当かを確認します。",
                  "ok": true
                },
                {
                  "text": "経路広告",
                  "explain": "到達できる宛先を知らせるだけです。",
                  "ok": false
                }
              ]
            },
            {
              "key": "c",
              "label": "改ざん検出",
              "why": "本問は従来型の暗号スイートを前提にしています。",
              "choices": [
                {
                  "text": "メッセージ認証",
                  "explain": "共有秘密を用いる検証によりメッセージの改ざんなどを検出します。",
                  "ok": true
                },
                {
                  "text": "データ圧縮",
                  "explain": "ハッシュ値を本文の代わりに送って復元することはできません。",
                  "ok": false
                }
              ]
            }
          ],
          "stage": "assemble",
          "id": "tls-roles-5",
          "theme": "暗号化だけでは守れない",
          "format": "穴埋め",
          "scaffold": 1
        },
        {
          "type": "quiz",
          "title": "練習用変更条件：暗号化はできるが相手確認を省略した。残る問題は？",
          "choices": [
            {
              "text": "暗号化した文字が必ず平文に戻る",
              "explain": "相手認証の省略が暗号化処理を直接無効にするわけではありません。",
              "ok": false
            },
            {
              "text": "偽の相手とも秘密の通信を確立してしまう",
              "explain": "暗号化された通信でも、相手が攻撃者なら秘密を渡してしまいます。",
              "ok": true
            }
          ],
          "stage": "transfer",
          "id": "tls-roles-6",
          "theme": "暗号化だけでは守れない",
          "format": "選択",
          "scaffold": 0
        }
      ]
    },
    {
