                  "explain": "配送先のサーバ名を得ます。",
                  "ok": true
                }
              ]
            },
            {
              "key": "b",
              "label": "転送",
              "why": "送る側の約束です。",
              "choices": [
                {
                  "text": "DNS",
                  "explain": "DNSは名前の情報を返します。",
                  "ok": false
                },
                {
                  "text": "SMTP",
                  "explain": "メール配送に使います。",
                  "ok": true
                }
              ]
            }
          ]
