          "stage": "transfer"
        }
      ]
    },
    {
      "id": "relay",
      "title": "認証で中継の利用者を限定する",
      "targets": [
        "s1",
        "s2-1"
      ],
      "steps": [
        {
          "id": "relay-1",
          "format": "読む",
          "theme": "認証で中継の利用者を限定する",
          "scaffold": 5,
          "type": "info",
          "title": "届くことと中継してよいことは別",
          "body": "自社宛てメールの受信と、外部から外部へのメール中継は別です。誰にでも中継を許すと、迷惑メール送信の踏み台になります。SMTP-AUTHはSMTP上で利用者を認証する機能で、暗号化そのものではありません。原問のエと設問2(1)につながります。",
          "stage": "concept"
        },
        {
          "id": "relay-2",
          "format": "選択",
          "theme": "認証で中継の利用者を限定する",
          "scaffold": 3,
          "type": "quiz",
          "title": "外部の匿名利用者から、別の外部ドメイン宛ての中継を頼まれた。危険は？",
          "choices": [
            {
              "text": "自社宛てメールが必ず暗号化される",
              "explain": "中継許可は暗号化を実行する設定ではありません。",
              "ok": false
            },
            {
              "text": "不正メール送信の踏み台になる",
              "explain": "自社サーバを経由して第三者へ送信できてしまいます。",
              "ok": true
            }
          ],
          "stage": "check"
        },
        {
          "id": "relay-3",
          "format": "選択",
          "theme": "認証で中継の利用者を限定する",
          "scaffold": 3,
          "type": "quiz",
          "title": "TLSで暗号化するだけでは中継の許可条件として不十分なのは？",
          "choices": [
            {
              "text": "TLSでは一切メールを送れないから",
              "explain": "TLS上でもSMTPを利用できます。",
              "ok": false
            },
            {
              "text": "通信を保護しても正規利用者かは別だから",
              "explain": "TLSによる通信保護とSMTP利用者認証を分けて考えます。",
              "ok": true
            }
          ],
          "stage": "reason"
        },
        {
          "id": "relay-4",
          "format": "穴埋め",
          "theme": "認証で中継の利用者を限定する",
          "scaffold": 3,
          "type": "blank",
          "title": "誰に中継させるか",
          "template": "{a}で利用者を確かめ、{b}からの外部宛て中継を許可する。",
          "stage": "apply",
          "blanks": [
            {
              "key": "a",
              "label": "機能",
              "why": "暗号化とは役割が違います。",
              "choices": [
                {
                  "text": "MX",
                  "explain": "MXは配送先を公開します。",
                  "ok": false
                },
                {
                  "text": "SMTP-AUTH",
                  "explain": "SMTP上のユーザ認証です。",
                  "ok": true
                }
              ]
            },
            {
              "key": "b",
              "label": "対象",
              "why": "匿名の全員には許可しません。",
              "choices": [
                {
                  "text": "全ての外部ホスト",
                  "explain": "オープンリレーの危険を残します。",
                  "ok": false
                },
                {
                  "text": "認証された利用者",
                  "explain": "業務で利用を認めた利用者に限定できます。",
                  "ok": true
                }
              ]
            }
          ]
        },
        {
          "id": "relay-5",
          "format": "並べ替え",
          "theme": "認証で中継の利用者を限定する",
          "scaffold": 1,
          "type": "parsons",
          "title": "危険を因果で説明する",
          "lead": "原因から結果へ並べよう。",
          "stage": "assemble",
          "lines": [
            {
              "code": "外部から外部宛ての中継を無条件に許可する"
            },
            {
              "code": "第三者が自社サーバへ不正メールの中継を依頼できる"
            },
            {
              "code": "自社サーバが不正メールの踏み台になる"
            }
          ],
          "shuffled": [
            1,
            0,
            2
          ],
          "okOrders": [
            [
              0,
              1,
              2
            ]
          ],
          "okExplain": "誰が何をできる結果、どのリスクになるかを示します。",
          "ngExplain": "単に『安全でない』で止めず、中継と踏み台の因果をつなぎます。"
        },
        {
          "id": "relay-6",
          "format": "選択",
          "theme": "認証で中継の利用者を限定する",
          "scaffold": 0,
          "type": "quiz",
          "title": "練習用変更：正規利用者が暗号化せずSMTP-AUTHに成功した。言えることは？",
          "choices": [
            {
              "text": "認証成功で全経路が暗号化済み",
              "explain": "SMTP-AUTHは暗号化開始の意味ではありません。",
              "ok": false
            },
            {
              "text": "認証と盗聴対策は別であり通信保護も必要",
              "explain": "認証できても経路上の情報保護まで保証しません。",
              "ok": true
            }
          ],
          "stage": "transfer"
        }
      ]
    },
    {
      "id": "op25",
      "title": "送信方向とISP境界を読む",
