                "x": 275,
                "y": 70,
                "icon": "server"
              }
            ],
            "links": [
              {
                "from": "node0",
                "to": "node1"
              },
              {
                "from": "node1",
                "to": "node2"
              }
            ],
            "caption": "説明用：OP25Bの適用位置"
          }
        },
        {
          "id": "op25-2",
          "format": "選択",
          "theme": "送信方向とISP境界を読む",
          "scaffold": 3,
          "type": "quiz",
          "title": "原問のポリシで禁止に該当する組合せは？",
          "choices": [
            {
              "text": "固定IPから自社網外へのTCP宛先587",
              "explain": "動的IPという条件も25番という条件も満たしません。",
              "ok": false
